<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lémou et Touty</title>
<meta name="theme-color" content="#f3ece0">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<style>
:root{--bg:#f3ece0;--card:#fffdf9;--tx:#2b2418;--mut:#7a6e5c;--pri:#1f3d33;--pt:#fffdf9;--bd:#e4d9c6;--sand:#ece2d0;--gold:#9a722a;--acc:#b98a3e;--bad:#a63a2b;--ok:#2d6a4f;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:17px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:14px}
h1,h2,.brand b,.code{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif}
.shell{max-width:560px;margin:0 auto;background:var(--card);border:1px solid var(--bd);border-radius:28px;padding:22px 22px 26px}
.brand{display:flex;align-items:center;gap:14px}
.brand svg{width:48px;height:48px;flex:none;color:var(--pri)}
.brand b{display:block;font-size:1.25rem;line-height:1.2}
.eb{display:block;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--mut)}
.gold{color:var(--gold);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;font-weight:800;margin:26px 0 8px}
h1{font-size:2.3rem;line-height:1.08;letter-spacing:-.02em;font-weight:700;margin:0 0 12px;overflow-wrap:anywhere}
h2{font-size:1.25rem;font-weight:700;margin:24px 0 6px}
.lead{margin:0 0 6px}
.mut{color:var(--mut);font-size:.95rem;margin:6px 0}
.bar{height:8px;background:var(--sand);border-radius:9px;overflow:hidden;margin:14px 0 4px}
.bar i{display:block;height:100%;background:var(--acc)}
#tabs{display:flex;gap:8px;overflow-x:auto;margin-top:18px;padding-bottom:2px}
#tabs button{flex:none;background:var(--card);border:1px solid var(--bd);color:var(--tx);border-radius:99px;padding:9px 16px;font:inherit;font-size:.9rem;font-weight:600;cursor:pointer}
#tabs button.on{background:var(--pri);color:var(--pt);border-color:var(--pri)}
.gc{display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:20px;padding:14px;margin:10px 0;font:inherit;cursor:pointer}
.av{flex:none;width:48px;height:48px;border-radius:50%;background:var(--sand);color:var(--pri);display:grid;place-items:center;font-weight:800}
.gi{flex:1;min-width:0}.gi b{display:block}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 0;border-bottom:1px solid var(--bd)}
label{display:block;margin:16px 0 8px;font-weight:700}
input,textarea,select{width:100%;padding:15px;border:1px solid var(--bd);border-radius:14px;background:#fff;color:var(--tx);font:inherit}
textarea{min-height:96px}
.btn{display:inline-block;background:var(--pri);color:var(--pt);border:1px solid var(--pri);border-radius:12px;padding:14px 22px;font:inherit;font-weight:700;text-decoration:none;cursor:pointer;margin-top:16px}
.btn.g{background:transparent;color:var(--tx);border-color:var(--tx)}
.btn.s{padding:9px 13px;margin:0 0 0 6px;font-size:.9rem;border-radius:10px}
.lnk{background:none;border:0;color:var(--pri);font:inherit;font-weight:700;padding:0;cursor:pointer;text-decoration:underline}
.chip{font-size:.78rem;padding:2px 9px;border-radius:99px;border:1px solid var(--bd);color:var(--mut);font-weight:600;white-space:nowrap}
.chip.ok{color:var(--ok);border-color:var(--ok)}.chip.bad{color:var(--bad);border-color:var(--bad)}
.act{display:flex;align-items:center;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end}
.nav{display:flex;justify-content:space-between;align-items:center;margin-top:14px}
.ic{background:var(--card);border:1px solid var(--bd);color:var(--tx);border-radius:12px;width:44px;height:44px;font-size:1.3rem;cursor:pointer}
.err{color:var(--bad);min-height:1.2em;margin:6px 0 0}
.foot{color:var(--mut);margin:28px 0 0}
.note{background:var(--sand);border-radius:14px;padding:12px 14px;margin:12px 0}
.code{font-size:2rem;font-weight:700;letter-spacing:.2em;margin:6px 0}
</style>
</head>
<body>
<div class="shell">
<div class="brand"><svg viewBox="0 0 52 52" aria-hidden="true"><circle cx="20" cy="26" r="13" fill="none" stroke="currentColor" stroke-width="6"/><circle cx="32" cy="26" r="13" fill="none" stroke="#b98a3e" stroke-width="6"/></svg><div><span class="eb">Associations et tontines</span><b>Lémou et Touty</b></div></div>
<div id="back"></div>
<nav id="tabs"></nav>
<div id="top"></div>
<main id="app"></main>
<p class="foot">Version de test · Vos données sont enregistrées en ligne.</p>
<p id="inst"></p>
</div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.57.4/dist/umd/supabase.min.js"></script>
<script>
var MOIS=["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
var SB=null,U=null,P={},view="auth",mode="in",tab="cot",MS=[],GR=null,MB=[],PR={},PY=[],NW=[],adding=false,joining=false,info="",arm=null,dp=null;
function $(s){return document.querySelector(s)}
function ym(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")}
var month=ym(new Date());
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function fmt(n){return Number(n).toLocaleString("fr-FR")+" FCFA"}
function label(m){var p=m.split("-");return MOIS[+p[1]-1]+" "+p[0]}
function shift(m,d){var p=m.split("-").map(Number);return ym(new Date(p[0],p[1]-1+d,1))}
function ini(n){return esc(String(n).trim().split(/\s+/).slice(0,2).map(function(w){return w[0]}).join("").toUpperCase())}
function E(t){var e=$("#err");if(e)e.textContent=t||""}
function fr(m){m=String(m||"");if(/Invalid login/i.test(m))return"Email ou mot de passe incorrect.";if(/already registered/i.test(m))return"Cet email a déjà un compte.";if(/at least 6/i.test(m))return"Le mot de passe doit avoir au moins 6 caractères.";if(/valid email|invalid format/i.test(m))return"Adresse email invalide.";if(/rate limit/i.test(m))return"Trop d’essais. Réessayez plus tard.";return m}
function wa(t,phone){var d=(phone||"").replace(/\D/g,"");if(d.length===9)d="221"+d;return"https://wa.me/"+d+"?text="+encodeURIComponent(t)}
function mgr(){return GR&&GR.role==="responsable"}
function pay(uid){return PY.filter(function(y){return y.user_id===uid})[0]}
function nm(uid){return PR[uid]?PR[uid].full_name||"Membre":"Membre"}
function ph(uid){return PR[uid]?PR[uid].phone:""}
function actives(){return MB.filter(function(x){return x.status==="active"})}
function payTxt(g){var a=[];if(g.pay_wave)a.push("Wave : "+g.pay_wave);if(g.pay_om)a.push("Orange Money : "+g.pay_om);return a.length?" Envoie ta cotisation par "+a.join(" ou ")+".":""}
function rem(uid){var g=GR.groups;return"Bonjour "+nm(uid)+", petit rappel : la cotisation de "+label(month)+" ("+fmt(g.amount)+") pour "+g.name+" n’est pas encore réglée."+payTxt(g)+" Merci !"}
function rec(uid){var g=GR.groups;return"Reçu — "+g.name+"\n"+nm(uid)+" a payé "+fmt(g.amount)+" pour "+label(month)+".\nMerci !"}
function cp(t){try{navigator.clipboard.writeText(t)}catch(e){}}

async function signIn(){
  var r=await SB.auth.signInWithPassword({email:$("#em").value.trim(),password:$("#pw").value});
  if(r.error)return E(fr(r.error.message));
  U=r.data.user;go();
}
async function signUp(){
  var n=$("#fn").value.trim(),ph=$("#ph").value.trim(),em=$("#em").value.trim(),pw=$("#pw").value;
  if(!n||!em||pw.length<6)return E("Entrez votre nom, votre email et un mot de passe de 6 caractères minimum.");
  var r=await SB.auth.signUp({email:em,password:pw,options:{data:{full_name:n,phone:ph}}});
  if(r.error)return E(fr(r.error.message));
  if(r.data.session){U=r.data.user;go()}else E("Compte créé. Confirmez votre email puis connectez-vous.");
}
async function logout(){await SB.auth.signOut();U=null;MS=[];GR=null;view="auth";mode="in";render()}
function setMode(m){mode=m;render()}
async function go(){
  if(!U){view="auth";render();return}
  await loadHome();view="home";GR=null;arm=null;render();
}
async function loadHome(){
  var a=await SB.from("profiles").select("full_name,phone").eq("id",U.id).maybeSingle();
  P=a.data||{full_name:"",phone:""};
  var r=await SB.from("memberships").select("id,role,status,group_id,groups(id,name,amount,invite_code,pay_wave,pay_om)").eq("user_id",U.id).order("created_at");
  MS=r.data||[];
}
async function openG(id){
  GR=MS.filter(function(m){return m.group_id===id})[0];tab="cot";arm=null;month=ym(new Date());
  await loadGroup();view="group";render();
}
async function loadGroup(){
  var id=GR.groups.id;
  var m=await SB.from("memberships").select("id,user_id,role,status").eq("group_id",id);
  MB=m.data||[];
  var p=await SB.from("profiles").select("id,full_name,phone").in("id",MB.map(function(x){return x.user_id}));
  PR={};(p.data||[]).forEach(function(x){PR[x.id]=x});
  var n=await SB.from("announcements").select("*").eq("group_id",id).order("created_at",{ascending:false});
  NW=n.data||[];
  await loadPay();
}
async function loadPay(){var y=await SB.from("payments").select("*").eq("group_id",GR.groups.id).eq("month",month);PY=y.data||[]}
async function reload(){await loadGroup();render()}
async function mv(d){month=shift(month,d);await loadPay();render()}
function setTab(t){tab=t;arm=null;render()}
function showNew(){adding=true;joining=false;render()}
function showJoin(){joining=true;adding=false;render()}

async function createGroup(){
  var n=$("#gn").value.trim(),a=+$("#ga").value;
  if(n.length<2||!(a>0))return E("Entrez un nom et un montant supérieur à 0.");
  var r=await SB.from("groups").insert({name:n,amount:a}).select().single();
  if(r.error)return E(fr(r.error.message));
  adding=false;await loadHome();openG(r.data.id);
}
async function joinGroup(){
  var c=$("#jc").value.trim();if(!c)return E("Entrez le code du groupe.");
  var r=await SB.rpc("join_group",{code:c});
  if(r.error)return E(fr(r.error.message));
  joining=false;info="Demande envoyée à « "+r.data+" ». Le responsable doit l’accepter.";await loadHome();render();
}
async function confirmPay(uid){
  var y=pay(uid),g=GR.groups,now=new Date().toISOString(),r;
  if(y)r=await SB.from("payments").update({status:"confirmed",confirmed_at:now}).eq("id",y.id);
  else r=await SB.from("payments").insert({group_id:g.id,user_id:uid,month:month,amount:g.amount,method:"especes",status:"confirmed",confirmed_at:now});
  if(r.error)return E(fr(r.error.message));
  await loadPay();render();
}
async function undoPay(uid){var y=pay(uid);if(!y)return;await SB.from("payments").delete().eq("id",y.id);await loadPay();render()}
async function iPaid(){
  var g=GR.groups,r=await SB.from("payments").insert({group_id:g.id,user_id:U.id,month:month,amount:g.amount,method:$("#pm").value,reference:$("#pr").value.trim(),status:"pending"});
  if(r.error)return E(fr(r.error.message));
  await loadPay();render();
}
async function setSt(id,s){await SB.from("memberships").update({status:s}).eq("id",id);await reload()}
async function delM(id){if(arm!==id){arm=id;render();return}arm=null;await SB.from("memberships").delete().eq("id",id);await reload()}
async function addNews(){
  var t=$("#nt").value.trim(),b=$("#nb").value.trim();if(!t)return E("Entrez un titre.");
  var r=await SB.from("announcements").insert({group_id:GR.groups.id,title:t,body:b});
  if(r.error)return E(fr(r.error.message));
  await reload();
}
async function delNews(id){await SB.from("announcements").delete().eq("id",id);await reload()}
async function saveSet(){
  var a=+$("#sa").value,w=$("#pw").value.trim(),o=$("#po").value.trim();
  if(!(a>0))return E("Le montant doit être supérieur à 0.");
  var r=await SB.from("groups").update({amount:a,pay_wave:w,pay_om:o}).eq("id",GR.groups.id);
  if(r.error)return E(fr(r.error.message));
  GR.groups.amount=a;GR.groups.pay_wave=w;GR.groups.pay_om=o;render();E("Enregistré.");
}
async function delG(){
  if(arm!=="g"){arm="g";render();return}
  await SB.from("groups").delete().eq("id",GR.groups.id);await go();
}
async function leave(){
  if(arm!=="l"){arm="l";render();return}
  await SB.from("memberships").delete().eq("id",GR.id);await go();
}

function vCot(){
  var g=GR.groups,h='<div class="nav"><button class="ic" onclick="mv(-1)" aria-label="Mois précédent">‹</button><b>'+label(month)+'</b><button class="ic" onclick="mv(1)" aria-label="Mois suivant">›</button></div>';
  if(g.pay_wave||g.pay_om)h+='<div class="note"><b>Où envoyer la cotisation</b><br>'+(g.pay_wave?'Wave : '+esc(g.pay_wave)+' ':'')+(g.pay_om?'· Orange Money : '+esc(g.pay_om):'')+'</div>';
  if(mgr())return h+actives().map(function(x){
    var u=x.user_id,y=pay(u),ok=y&&y.status==="confirmed",pe=y&&y.status==="pending";
    return'<div class="row"><div><b>'+esc(nm(u))+'</b><br><span class="chip '+(ok?"ok":pe?"":"bad")+'">'+(ok?"Payé":pe?"À confirmer":"Impayé")+'</span>'+(pe?'<br><span class="mut">'+esc(y.method)+(y.reference?' · '+esc(y.reference):'')+'</span>':'')+'</div><div class="act">'+
    (ok?'<a class="btn s g" target="_blank" rel="noopener" href="'+wa(rec(u),ph(u))+'">Reçu</a><button class="btn s g" onclick="undoPay(\''+u+'\')">Annuler</button>'
      :pe?'<button class="btn s g" onclick="undoPay(\''+u+'\')">Refuser</button><button class="btn s" onclick="confirmPay(\''+u+'\')">Confirmer</button>'
      :'<a class="btn s g" target="_blank" rel="noopener" href="'+wa(rem(u),ph(u))+'">Rappel</a><button class="btn s" onclick="confirmPay(\''+u+'\')">Marquer payé</button>')+'</div></div>';
  }).join("");
  var y=pay(U.id);
  if(y&&y.status==="confirmed")return h+'<p><span class="chip ok">Payé</span> Votre cotisation de '+label(month)+' est confirmée.</p><a class="btn g" target="_blank" rel="noopener" href="'+wa(rec(U.id),"")+'">Envoyer mon reçu sur WhatsApp</a>';
  if(y)return h+'<p><span class="chip">En attente</span> Le responsable doit confirmer votre paiement.</p>';
  return h+'<h2>Déclarer mon paiement</h2><p class="mut">Montant : <b>'+fmt(g.amount)+'</b></p><label>Moyen utilisé</label><select id="pm"><option value="wave">Wave</option><option value="orange_money">Orange Money</option><option value="especes">Espèces</option></select><label>Référence ou numéro de transaction (facultatif)</label><input id="pr"><p class="err" id="err"></p><button class="btn" onclick="iPaid()">J’ai payé</button>';
}
function vMem(){
  if(!mgr())return'<p class="mut">Cette page est réservée au responsable du groupe.</p>';
  var pend=MB.filter(function(x){return x.status==="pending"}),A=actives();
  var h='<h2>Demandes d’adhésion ('+pend.length+')</h2>';
  h+=pend.length?pend.map(function(x){return'<div class="row"><div><b>'+esc(nm(x.user_id))+'</b><br><span class="mut">'+esc(ph(x.user_id)||"Pas de numéro")+'</span></div><div class="act"><button class="btn s g" onclick="setSt(\''+x.id+'\',\'refused\')">Refuser</button><button class="btn s" onclick="setSt(\''+x.id+'\',\'active\')">Accepter</button></div></div>'}).join(""):'<p class="mut">Aucune demande en attente.</p>';
  return h+'<h2>Membres ('+A.length+')</h2>'+A.map(function(x){
    return'<div class="row"><div><b>'+esc(nm(x.user_id))+'</b><br><span class="mut">'+esc(ph(x.user_id)||"Pas de numéro")+'</span></div>'+(x.role==="responsable"?'<span class="chip ok">Responsable</span>':'<button class="btn s g" onclick="delM(\''+x.id+'\')">'+(arm===x.id?"Confirmer":"Retirer")+'</button>')+'</div>';
  }).join("");
}
function vNews(){
  var g=GR.groups,h="";
  if(mgr())h+='<label>Titre</label><input id="nt" placeholder="Ex : Réunion samedi"><label>Message</label><textarea id="nb" placeholder="Votre annonce"></textarea><p class="err" id="err"></p><button class="btn" onclick="addNews()">Publier l’annonce</button>';
  h+='<h2>Annonces</h2>';
  if(!NW.length)h+='<p class="mut">Aucune annonce pour l’instant.</p>';
  return h+NW.map(function(n){
    return'<div class="row"><div><b>'+esc(n.title)+'</b><br><span class="mut">'+new Date(n.created_at).toLocaleDateString("fr-FR")+(n.body?' · '+esc(n.body):'')+'</span></div><div class="act"><a class="btn s g" target="_blank" rel="noopener" href="'+wa(g.name+" — "+n.title+(n.body?"\n"+n.body:""),"")+'">Partager</a>'+(mgr()?'<button class="btn s g" onclick="delNews(\''+n.id+'\')">×</button>':'')+'</div></div>';
  }).join("");
}
function vSet(){
  var g=GR.groups;
  if(!mgr())return'<p class="mut">Vous êtes membre de ce groupe.</p><button class="btn g" onclick="leave()">'+(arm==="l"?"Confirmer : quitter le groupe":"Quitter le groupe")+'</button>';
  var link=location.href.split("#")[0].split("?")[0];
  return'<h2>Inviter des membres</h2><p class="mut">Code du groupe</p><div class="code">'+esc(g.invite_code)+'</div><a class="btn g" target="_blank" rel="noopener" href="'+wa("Rejoins « "+g.name+" » sur Lémou et Touty. Crée ton compte puis entre le code "+g.invite_code+" : "+link,"")+'">Partager sur WhatsApp</a><button class="btn g" onclick="cp(\''+esc(g.invite_code)+'\')">Copier le code</button>'+
  '<h2>Paramètres</h2><label>Cotisation par membre et par mois (FCFA)</label><input id="sa" type="number" inputmode="numeric" value="'+g.amount+'"><label>Numéro Wave pour recevoir les cotisations</label><input id="pw" type="tel" value="'+esc(g.pay_wave)+'" placeholder="77 123 45 67"><label>Numéro Orange Money</label><input id="po" type="tel" value="'+esc(g.pay_om)+'" placeholder="78 123 45 67"><p class="err" id="err"></p><button class="btn" onclick="saveSet()">Enregistrer</button><p class="note">Le paiement par carte et la confirmation automatique arrivent plus tard.</p><button class="btn g" onclick="delG()">'+(arm==="g"?"Confirmer : supprimer le groupe":"Supprimer ce groupe")+'</button>';
}
function install(){
  var el=$("#inst");
  if(window.matchMedia&&matchMedia("(display-mode: standalone)").matches){el.innerHTML="";return}
  el.innerHTML='<button class="lnk" onclick="doInst()">Installer l’app</button><span class="mut" id="ih"></span>';
}
function doInst(){if(dp){dp.prompt();dp=null}else $("#ih").textContent=" Android : menu ⋮ puis Installer l’application. iPhone : Partager puis Sur l’écran d’accueil."}
window.addEventListener("beforeinstallprompt",function(e){e.preventDefault();dp=e});

function render(){
  var app=$("#app"),top=$("#top"),tabs=$("#tabs"),back=$("#back");
  tabs.style.display="none";top.innerHTML="";back.innerHTML="";
  if(view==="auth"){
    top.innerHTML='<p class="gold">Bienvenue</p><h1>'+(mode==="in"?"Connexion":"Créer un compte")+'</h1><p class="lead">'+(mode==="in"?"Connectez-vous pour retrouver vos groupes.":"Un compte vous permet de rejoindre ou de gérer des groupes.")+'</p>';
    app.innerHTML=(mode==="up"?'<label>Nom complet</label><input id="fn" autocomplete="name"><label>Téléphone WhatsApp</label><input id="ph" type="tel" autocomplete="tel" placeholder="77 123 45 67">':'')+'<label>Email</label><input id="em" type="email" autocomplete="email"><label>Mot de passe</label><input id="pw" type="password" autocomplete="'+(mode==="in"?"current-password":"new-password")+'"><p class="err" id="err"></p><button class="btn" onclick="'+(mode==="in"?"signIn()":"signUp()")+'">'+(mode==="in"?"Se connecter":"Créer mon compte")+'</button><p class="mut">'+(mode==="in"?'Pas de compte ? <button class="lnk" onclick="setMode(\'up\')">Créer un compte</button>':'Déjà un compte ? <button class="lnk" onclick="setMode(\'in\')">Se connecter</button>')+'</p>';
    install();return;
  }
  if(view==="home"){
    back.innerHTML='<p class="mut" style="margin:18px 0 0">'+esc(P.full_name||U.email)+' · <button class="lnk" onclick="logout()">Se déconnecter</button></p>';
    top.innerHTML='<p class="gold">Bienvenue</p><h1>Mes groupes</h1><p class="lead">Choisissez un groupe pour continuer.</p>';
    var h=info?'<div class="note">'+esc(info)+'</div>':"";
    h+=MS.map(function(m){
      if(m.status==="active"&&m.groups)return'<button class="gc" onclick="openG(\''+m.group_id+'\')"><span class="av">'+ini(m.groups.name)+'</span><span class="gi"><b>'+esc(m.groups.name)+'</b><span class="mut">'+fmt(m.groups.amount)+' / mois</span></span><span class="chip ok">'+(m.role==="responsable"?"Responsable":"Membre")+'</span></button>';
      return'<div class="gc"><span class="av">…</span><span class="gi"><b>Demande d’adhésion</b><span class="mut">'+(m.status==="refused"?"Refusée par le responsable":"En attente de réponse")+'</span></span></div>';
    }).join("");
    if(!MS.length)h+='<p class="mut">Vous n’avez pas encore de groupe.</p>';
    if(adding)h+='<h2>Nouveau groupe</h2><label>Nom du groupe</label><input id="gn" placeholder="Ex : Tontine des sœurs"><label>Cotisation par membre et par mois (FCFA)</label><input id="ga" type="number" inputmode="numeric" placeholder="5000"><p class="err" id="err"></p><button class="btn" onclick="createGroup()">Créer le groupe</button>';
    else if(joining)h+='<h2>Rejoindre un groupe</h2><label>Code donné par le responsable</label><input id="jc" placeholder="Ex : A1B2C3" autocapitalize="characters"><p class="err" id="err"></p><button class="btn" onclick="joinGroup()">Envoyer la demande</button>';
    else h+='<button class="btn" onclick="showNew()">Créer un groupe</button> <button class="btn g" onclick="showJoin()">Rejoindre un groupe</button>';
    app.innerHTML=h;install();return;
  }
  var g=GR.groups,A=actives(),n=A.length,p=A.filter(function(x){var y=pay(x.user_id);return y&&y.status==="confirmed"}).length;
  back.innerHTML='<p style="margin:18px 0 0"><button class="lnk" onclick="go()">‹ Mes groupes</button></p>';
  top.innerHTML=mgr()?'<p class="gold">'+esc(g.name)+' · '+label(month)+'</p><h1>'+fmt(p*g.amount)+'</h1><p class="lead">'+p+' sur '+n+' ont payé · reste '+fmt((n-p)*g.amount)+'</p><div class="bar"><i style="width:'+(n?Math.round(p/n*100):0)+'%"></i></div>'
    :'<p class="gold">'+esc(g.name)+' · '+label(month)+'</p><h1>'+fmt(g.amount)+'</h1><p class="lead">Cotisation mensuelle</p>';
  var T=mgr()?[["cot","Cotisations"],["mem","Membres"],["news","Annonces"],["set","Réglages"]]:[["cot","Cotisation"],["news","Annonces"],["set","Groupe"]];
  var pc=MB.filter(function(x){return x.status==="pending"}).length;
  tabs.style.display="flex";
  tabs.innerHTML=T.map(function(t){return'<button class="'+(tab===t[0]?"on":"")+'" onclick="setTab(\''+t[0]+'\')">'+t[1]+(t[0]==="mem"&&pc?" ("+pc+")":"")+'</button>'}).join("");
  app.innerHTML={cot:vCot,mem:vMem,news:vNews,set:vSet}[tab]();install();
}
async function boot(){
  if(!window.supabase){$("#app").innerHTML='<p class="err">Impossible de charger le service en ligne. Vérifiez votre connexion et rechargez la page.</p>';return}
  SB=window.supabase.createClient("https://fyqyzzgygsstmqvnasps.supabase.co","sb_publishable_ex-1Mrg3qfgwAbaSeFwCQQ_3G2Uq8p4");
  try{var r=await SB.auth.getSession();U=r.data.session?r.data.session.user:null}catch(e){U=null}
  go();
}
try{if("serviceWorker" in navigator)navigator.serviceWorker.register("sw.js")}catch(e){}
boot();
</script>
</body>
</html>
